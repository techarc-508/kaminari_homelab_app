<?xml version="1.0" encoding="utf-8"?>
<!--
  Kaminari Nfty network policy.

  Plain http stays blocked everywhere except the loopback addresses used by
  development and Robolectric tests. The gateway is reached over TLS on the
  private tailnet endpoint, whose certificate is issued by the Kaminari Gateway
  Private CA (validity 825 days, SANs limited to the gateway's tailnet/LAN
  addresses). The CA private key never leaves the offline PKI directory, so
  trusting the root here does not let anyone else impersonate the gateway.

  The gateway certificate itself is additionally bound by the URL policy in
  GatewayUrlPolicy (https required for every non-loopback host).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/kf_gateway_ca" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
