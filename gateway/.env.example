# Kaminari Proxmox Gateway — environment configuration template
#
# Copy this file to .env and fill in real values.
# Do not commit the populated .env file.
#
# All variables are prefixed with GATEWAY_ at runtime by pydantic-settings.
# The real variable names below are the file-level names; the app reads them
# with the GATEWAY_ prefix automatically.

# Authentication token for the Android client.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(43))"
GATEWAY_GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# Proxmox API base URL. Must use https://.
GATEWAY_PROXMOX_BASE_URL=https://proxmox.example:8006/api2/json

# Proxmox API token for the gateway service account.
# Format: USER@REALM!USERNAME=SECRET
GATEWAY_PROXMOX_API_TOKEN=REPLACE_WITH_PROXMOX_API_TOKEN

# TLS verification for Proxmox API calls.
# Set to false only in development with trust-established private CAs.
GATEWAY_PROXMOX_VERIFY_TLS=true

# Proxmox API request timeout in seconds.
GATEWAY_PROXMOX_TIMEOUT_SECONDS=10.0

# Enable Proxmox mutations? false by default.
GATEWAY_MUTATIONS_ENABLED=false

# Rate limit per client key per minute.
GATEWAY_RATE_LIMIT_PER_MINUTE=60

# Maximum request body size in bytes.
GATEWAY_MAX_REQUEST_BYTES=65536
