# Kaminari Proxmox Gateway — environment template
#
# Copy to `gateway/.env`, fill in real values, and never commit the result.
# The application reads these with the GATEWAY_ prefix; the names below are the
# exact variable names.

# --- Credentials -----------------------------------------------------------
# Least-privilege gateway token (identity: kf_gateway).
#   python -c "import secrets; print(secrets.token_urlsafe(43))"
GATEWAY_GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# Optional previous token, accepted only during a rotation window.
# GATEWAY_PREVIOUS_GATEWAY_TOKEN=
# Optional hard expiry (ISO-8601 UTC). Empty means no expiry.
# GATEWAY_TOKEN_EXPIRES_AT=

# Separate owner credential (identity: kfadmin). Required for TOTP enrollment
# and audit reads. MUST differ from the gateway token.
#   python -c "import secrets; print(secrets.token_urlsafe(43))"
GATEWAY_OWNER_TOKEN=REPLACE_WITH_OWNER_RANDOM_TOKEN
# GATEWAY_PREVIOUS_OWNER_TOKEN=
# GATEWAY_OWNER_TOKEN_EXPIRES_AT=
GATEWAY_OWNER_IDENTITY=kfadmin
GATEWAY_GATEWAY_IDENTITY=kf_gateway

# --- Proxmox ---------------------------------------------------------------
# Must use https://. Use a narrowly scoped PVE API token, read-only for reads.
GATEWAY_PROXMOX_BASE_URL=https://proxmox.example:8006/api2/json
GATEWAY_PROXMOX_API_TOKEN=REPLACE_WITH_PROXMOX_API_TOKEN
GATEWAY_PROXMOX_VERIFY_TLS=true
GATEWAY_PROXMOX_TIMEOUT_SECONDS=10.0

# --- Safety ----------------------------------------------------------------
# Mutations stay disabled until TOTP step-up is enrolled and verified.
GATEWAY_MUTATIONS_ENABLED=false
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_MAX_REQUEST_BYTES=65536

# --- Durable state ---------------------------------------------------------
# Persistent path (container: /data, backed by a named volume).
GATEWAY_DB_PATH=/data/kaminari-gateway.db
GATEWAY_STEP_UP_CHALLENGE_TTL_SECONDS=60
GATEWAY_STEP_UP_WINDOW_STEPS=1
GATEWAY_STEP_UP_MAX_ATTEMPTS=5
